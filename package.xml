<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bilateral_arc_clearance_controller</name>
  <version>0.1.0</version>
  <description>
    Arc-clearance obstacle avoidance: shapes an upper-level velocity command so
    the robot avoids obstacles when there is room and funnels smoothly through
    the middle of narrow openings when there is not. Framework-free C++17 core
    library, a cmd_vel filter node for evaluation, and a nav2 controller plugin
    (built when nav2_core is available).
  </description>
  <maintainer email="hijikata@react-robot.com">Masaaki Hijikata</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend condition="$ROS_DISTRO != ''">rclcpp</build_depend>
  <build_depend condition="$ROS_DISTRO != ''">geometry_msgs</build_depend>
  <build_depend condition="$ROS_DISTRO != ''">nav_msgs</build_depend>
  <build_depend condition="$ROS_DISTRO != ''">sensor_msgs</build_depend>
  <build_depend condition="$ROS_DISTRO != ''">std_msgs</build_depend>

  <!-- Optional: nav2 controller plugin (skipped when not found) -->
  <build_depend condition="$ROS_DISTRO != ''">nav2_core</build_depend>
  <build_depend condition="$ROS_DISTRO != ''">nav2_costmap_2d</build_depend>
  <build_depend condition="$ROS_DISTRO != ''">nav2_util</build_depend>
  <build_depend condition="$ROS_DISTRO != ''">pluginlib</build_depend>
  <build_depend condition="$ROS_DISTRO != ''">rclcpp_lifecycle</build_depend>
  <build_depend condition="$ROS_DISTRO != ''">tf2</build_depend>
  <build_depend condition="$ROS_DISTRO != ''">tf2_geometry_msgs</build_depend>

  <exec_depend condition="$ROS_DISTRO != ''">rclcpp</exec_depend>
  <exec_depend condition="$ROS_DISTRO != ''">geometry_msgs</exec_depend>
  <exec_depend condition="$ROS_DISTRO != ''">nav_msgs</exec_depend>
  <exec_depend condition="$ROS_DISTRO != ''">sensor_msgs</exec_depend>
  <exec_depend condition="$ROS_DISTRO != ''">std_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
