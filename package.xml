<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bilateral_arc_clearance_controller</name>
  <version>0.1.0</version>
  <description>
    Arc-clearance obstacle avoidance: shapes an upper-level velocity command so
    the robot avoids obstacles when there is room and funnels smoothly through
    the middle of narrow openings when there is not. Framework-free C++17 core
    library, a cmd_vel filter node for evaluation, and a nav2 controller plugin.
  </description>
  <maintainer email="hijikata@react-robot.com">Masaaki Hijikata</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend condition="$ROS_DISTRO != ''">rclcpp</depend>
  <depend condition="$ROS_DISTRO != ''">rclcpp_lifecycle</depend>
  <depend condition="$ROS_DISTRO != ''">geometry_msgs</depend>
  <depend condition="$ROS_DISTRO != ''">nav_msgs</depend>
  <depend condition="$ROS_DISTRO != ''">sensor_msgs</depend>
  <depend condition="$ROS_DISTRO != ''">std_msgs</depend>
  <depend condition="$ROS_DISTRO != ''">nav2_core</depend>
  <depend condition="$ROS_DISTRO != ''">nav2_costmap_2d</depend>
  <depend condition="$ROS_DISTRO != ''">nav2_util</depend>
  <depend condition="$ROS_DISTRO != ''">pluginlib</depend>
  <depend condition="$ROS_DISTRO != ''">tf2</depend>
  <depend condition="$ROS_DISTRO != ''">tf2_geometry_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
