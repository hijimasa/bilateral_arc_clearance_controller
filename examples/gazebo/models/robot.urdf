<?xml version="1.0"?>
<robot name="bac_demo_robot">
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="18.0"/>
      <inertia ixx="0.45" ixy="0" ixz="0" iyy="0.70" iyz="0" izz="0.90"/>
    </inertial>
    <collision name="body_collision">
      <origin xyz="0 0 0.14"/>
      <geometry><box size="0.70 0.50 0.24"/></geometry>
    </collision>
    <visual name="body_visual">
      <origin xyz="0 0 0.14"/>
      <geometry><box size="0.70 0.50 0.24"/></geometry>
      <material name="bac_blue"><color rgba="0.05 0.35 0.95 1"/></material>
    </visual>
  </link>

  <link name="left_wheel">
    <inertial><mass value="0.5"/><origin xyz="0 0 0"/><inertia ixx="0.002" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.002"/></inertial>
    <collision><geometry><cylinder radius="0.10" length="0.05"/></geometry></collision>
    <visual><geometry><cylinder radius="0.10" length="0.05"/></geometry><material name="dark"><color rgba="0.05 0.05 0.05 1"/></material></visual>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="left_wheel"/>
    <origin xyz="0 0.28 0.10" rpy="1.57079632679 0 0"/><axis xyz="0 0 -1"/>
  </joint>

  <link name="right_wheel">
    <inertial><mass value="0.5"/><origin xyz="0 0 0"/><inertia ixx="0.002" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.002"/></inertial>
    <collision><geometry><cylinder radius="0.10" length="0.05"/></geometry></collision>
    <visual><geometry><cylinder radius="0.10" length="0.05"/></geometry><material name="dark"/></visual>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="right_wheel"/>
    <origin xyz="0 -0.28 0.10" rpy="1.57079632679 0 0"/><axis xyz="0 0 -1"/>
  </joint>

  <link name="rear_caster">
    <inertial><mass value="0.2"/><origin xyz="0 0 0"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/></inertial>
    <collision><geometry><sphere radius="0.045"/></geometry></collision>
    <visual><geometry><sphere radius="0.045"/></geometry><material name="dark"/></visual>
  </link>
  <joint name="rear_caster_joint" type="fixed">
    <parent link="base_link"/><child link="rear_caster"/><origin xyz="-0.27 0 0.045"/>
  </joint>

  <link name="laser_link"/>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/><child link="laser_link"/><origin xyz="0.25 0 0.27"/>
  </joint>

  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
    <sensor name="bumper" type="contact">
      <always_on>true</always_on><update_rate>50</update_rate>
      <contact><collision>body_collision</collision></contact>
      <plugin name="bumper_ros" filename="libgazebo_ros_bumper.so">
        <ros><remapping>bumper_states:=/bumper_states</remapping></ros>
        <frame_name>base_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  <gazebo reference="left_wheel"><material>Gazebo/Black</material><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="right_wheel"><material>Gazebo/Black</material><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="rear_caster"><material>Gazebo/Black</material><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>

  <gazebo reference="laser_link">
    <sensor name="laser" type="ray">
      <pose>0 0 0 0 0 0</pose><always_on>true</always_on><visualize>false</visualize><update_rate>20</update_rate>
      <ray>
        <scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159265</min_angle><max_angle>3.14159265</max_angle></horizontal></scan>
        <range><min>0.05</min><max>8.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.005</stddev></noise>
      </ray>
      <plugin name="laser_ros" filename="libgazebo_ros_ray_sensor.so">
        <ros><remapping>~/out:=/scan</remapping></ros>
        <output_type>sensor_msgs/LaserScan</output_type><frame_name>laser_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros><remapping>cmd_vel:=/cmd_vel</remapping><remapping>odom:=/odom</remapping></ros>
      <update_rate>50</update_rate><left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.56</wheel_separation><wheel_diameter>0.20</wheel_diameter>
      <max_wheel_torque>20.0</max_wheel_torque><max_wheel_acceleration>4.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom><publish_odom_tf>true</publish_odom_tf><publish_wheel_tf>false</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame><robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </gazebo>
</robot>
